# ──────────────────────────────────────────────
# SouthEast Properties — Environment Variables
# ──────────────────────────────────────────────

# The canonical production URL (no trailing slash).
# Used for metadataBase, Open Graph, sitemap, robots, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://southeastprop.co.za

# Set to "true" to enable @next/bundle-analyzer during build.
ANALYZE=false

# ── Database (PostgreSQL via Prisma) ──
# Railway: auto-injected when you add the Postgres add-on
# Local: docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/southeastprop?schema=public

# ── Admin user (for prisma db seed) ──
ADMIN_EMAIL=admin@southeastproperties.co.za
# ADMIN_PASSWORD=changeme

# ── Session encryption (iron-session) ──
# Must be at least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=development-secret-change-in-production-32chars

# ── Image uploads ──
# Local dev: defaults to public/uploads (served statically by Next.js)
# Railway: set by Dockerfile to /app/uploads (Railway Volume mount point)
# UPLOAD_DIR=/app/uploads

# ── Future integration points (not yet active) ──
# Email service (Resend, SendGrid, etc.)
# RESEND_API_KEY=
# CRM API key
# CRM_API_KEY=
# Error monitoring (Sentry, Bugsnag)
# SENTRY_DSN=